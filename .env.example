# Local Prisma CLI + SQLite file (must stay file: — do NOT use libsql here)
DATABASE_URL="file:./dev.db"

# Turso (production on Vercel) — runtime only, not for `prisma db push`
# TURSO_DATABASE_URL="libsql://your-db-org.turso.io"
# TURSO_AUTH_TOKEN="your-token"

# Private access
APP_PASSWORD=change-me-to-something-only-you-two-know
SESSION_TOKEN=generate-with-openssl-rand-hex-32
